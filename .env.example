# GENESIS OS — environment configuration template
# Copy to .env and fill in real values. Never commit .env itself.

# --- Runtime ---
GENESIS_ENV=development          # development | production

# --- Database ---
# Development default (SQLite):
GENESIS_DATABASE_URL=sqlite+aiosqlite:///./genesis.db
# Production (PostgreSQL) — override GENESIS_DATABASE_URL with:
# GENESIS_DATABASE_URL=postgresql+asyncpg://user:password@host:5432/genesis

# --- Vector Memory (Qdrant) ---
GENESIS_QDRANT_HOST=localhost
GENESIS_QDRANT_PORT=6333

# --- Cache (Redis) ---
GENESIS_REDIS_URL=redis://localhost:6379/0

# --- API ---
GENESIS_API_HOST=0.0.0.0
GENESIS_API_PORT=8000

# --- Logging ---
GENESIS_LOG_LEVEL=INFO
