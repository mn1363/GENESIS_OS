+
+
+class GraphNodeRecord(Base):
+    """One Knowledge Graph node, keyed by its caller-chosen `id`."""
+
+    __tablename__ = "knowledge_graph_nodes"
+
+    id: Mapped[str] = mapped_column(String(255), primary_key=True)
